<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DabTime" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dab_primary</item>
        <item name="colorPrimaryVariant">@color/dab_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dab_secondary</item>
        <item name="colorSecondaryVariant">@color/dab_secondary_variant</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    
    <!-- Light theme -->
    <style name="Theme.DabTime.Light" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/dab_primary</item>
        <item name="colorPrimaryVariant">@color/dab_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dab_secondary</item>
        <item name="colorSecondaryVariant">@color/dab_secondary_variant</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
    </style>
    
    <!-- Dark theme -->
    <style name="Theme.DabTime.Dark" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/dab_primary</item>
        <item name="colorPrimaryVariant">@color/dab_primary_variant</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/dab_secondary</item>
        <item name="colorSecondaryVariant">@color/dab_secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
    </style>
</resources>