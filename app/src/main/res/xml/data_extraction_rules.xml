<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive authentication data -->
        <exclude domain="sharedpref" path="firebase_auth_prefs.xml" />
        <exclude domain="sharedpref" path="user_credentials.xml" />
        
        <!-- Include user preferences for cloud backup -->
        <include domain="sharedpref" path="user_preferences.xml" />
        <include domain="sharedpref" path="timer_settings.xml" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Allow transfer of user preferences during device transfer -->
        <include domain="sharedpref" path="user_preferences.xml" />
        <include domain="sharedpref" path="timer_settings.xml" />
    </device-transfer>
</data-extraction-rules>